<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>causa</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Scenarios.fs" />
    <Compile Include="Dataset.fs" />
    <Compile Include="Gate.fs" />
    <Compile Include="LiveTests.fs" />
    <Compile Include="Historical/Research.fs" />
    <Compile Include="Historical/Kit.fs" />
    <Compile Include="Historical/Catalog.fs" />
    <Compile Include="Historical/Verify.fs" />
    <Compile Include="Historical/Apollo1.fs" />
    <Compile Include="Historical/Apollo11.fs" />
    <Compile Include="Historical/Challenger.fs" />
    <Compile Include="Historical/Cases.fs" />
    <Compile Include="Everyday.fs" />
    <Compile Include="Workspace.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../.engine/src/engine/App.Engine.fsproj" AdditionalProperties="$(CausaEngineBuildProperties)" />
    <ProjectReference Include="../Causa.Contract/Causa.Contract.fsproj" />
    <ProjectReference Include="../Causa.GitHub/Causa.GitHub.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Causa.Contract.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
