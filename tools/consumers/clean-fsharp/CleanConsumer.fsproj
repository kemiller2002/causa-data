<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>clean-consumer</AssemblyName>
    <RootNamespace>CleanConsumer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Json.fs" />
    <Compile Include="Wire.fs" />
    <Compile Include="Schema.fs" />
    <Compile Include="Domain.fs" />
    <Compile Include="Projection.fs" />
    <Compile Include="Verify.fs" />
    <Compile Include="Dataset.fs" />
    <Compile Include="AppendDemo.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../.engine/src/engine/App.Engine.fsproj" AdditionalProperties="$(CausaEngineBuildProperties)" />
  </ItemGroup>
</Project>
