{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kemiller2002/causa-data/catalog/schemas/catalog-manifest.schema.json",
  "title": "Causa active demonstration catalog manifest",
  "description": "catalog/<runId>/manifest.json. Lists the investigations of the active demonstration catalog, which live in workspaces/demo/<runId>/ and are ordinary Causa v1.0.0 file sets (CONTRACT §3, §9). Derived and canonical (RFC 8785 + LF). This catalog layer is outside the frozen v1.0.0 contract and does not change it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogId", "catalogVersion", "formatVersion", "semanticVersion", "schemaSha256", "engineCommit", "createdAt", "workspace", "cases", "retainedCompatibilityDataset"],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "text": { "type": "string", "minLength": 1 }
  },
  "properties": {
    "catalogId": { "const": "causa-historical" },
    "catalogVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "formatVersion": { "const": "1.0.0" },
    "semanticVersion": { "const": "1.0.0" },
    "schemaSha256": { "$ref": "#/$defs/sha256" },
    "engineCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "workspace": { "type": "string", "pattern": "^workspaces/demo/[a-z0-9][a-z0-9-]{0,63}$" },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseKey", "investigationId", "title", "path", "expectedVersion", "expectedLifecycle", "expectedStateSha256", "eventsSha256", "manifestSha256", "snapshotSha256", "researchSourcesSha256", "researchClaimsSha256", "provenanceSha256", "sourceCount", "primarySourceCount", "claimCount", "evidenceCount", "excludedClaimCount"],
        "properties": {
          "caseKey": { "enum": ["apollo-1", "apollo-11", "challenger-sts-51l"] },
          "investigationId": { "$ref": "#/$defs/uuid" },
          "title": { "$ref": "#/$defs/text" },
          "path": { "type": "string", "pattern": "^workspaces/demo/[a-z0-9][a-z0-9-]{0,63}/investigations/[0-9a-f-]{36}$" },
          "expectedVersion": { "type": "integer", "minimum": 1 },
          "expectedLifecycle": { "enum": ["draft", "active", "awaitingEvidence", "awaitingVerification", "resolved", "closed", "archived"] },
          "expectedStateSha256": { "$ref": "#/$defs/sha256" },
          "eventsSha256": { "$ref": "#/$defs/sha256" },
          "manifestSha256": { "$ref": "#/$defs/sha256" },
          "snapshotSha256": { "$ref": "#/$defs/sha256" },
          "researchSourcesSha256": { "$ref": "#/$defs/sha256" },
          "researchClaimsSha256": { "$ref": "#/$defs/sha256" },
          "provenanceSha256": { "$ref": "#/$defs/sha256" },
          "sourceCount": { "$ref": "#/$defs/count" },
          "primarySourceCount": { "$ref": "#/$defs/count" },
          "claimCount": { "$ref": "#/$defs/count" },
          "evidenceCount": { "$ref": "#/$defs/count" },
          "excludedClaimCount": { "$ref": "#/$defs/count" }
        }
      }
    },
    "retainedCompatibilityDataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "manifest", "status"],
      "properties": {
        "datasetId": { "const": "causa-demo-v1" },
        "manifest": { "const": "fixtures/v1.0.0/manifest.json" },
        "status": { "$ref": "#/$defs/text" }
      }
    }
  }
}
