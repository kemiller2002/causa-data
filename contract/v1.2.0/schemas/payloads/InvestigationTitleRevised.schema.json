{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kemiller2002/causa-data/contract/v1.2.0/schemas/payloads/InvestigationTitleRevised.schema.json",
  "title": "InvestigationTitleRevised payload",
  "description": "1.2.0: revises the investigation's title. The title is kept verbatim; reason is why, or null. A revision is a command group of its own.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "reason"
  ],
  "properties": {
    "title": {
      "$ref": "../common.schema.json#/$defs/text"
    },
    "reason": {
      "$ref": "../common.schema.json#/$defs/nullableText"
    }
  }
}
